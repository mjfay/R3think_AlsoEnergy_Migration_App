ALSOENERGY_BASE_URL=https://api.alsoenergy.com
DATABASE_URL=sqlite:///./alsoenergy.db

# Each user enters their own AlsoEnergy login in the browser — nothing to configure here.
# HttpOnly session cookie is always on; Secure requires HTTPS. Flip this on once this
# deployment sits behind TLS (it will silently fail to set the cookie over plain HTTP
# if left true without HTTPS).
SESSION_COOKIE_SECURE=false

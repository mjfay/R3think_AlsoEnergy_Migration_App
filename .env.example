# N3uron REST API — Altus Power
# Copy to .env and fill in credentials (search "N3uron" or "Altus" in Bitwarden)

N3URON_HOST=altuspower.r3thinklabs.io
N3URON_PORT=53443

# "basic" (username + password) or "token" (bearer token)
N3URON_AUTH_TYPE=basic

N3URON_USERNAME=
N3URON_PASSWORD=

# Only needed if AUTH_TYPE=token
N3URON_TOKEN=

# Self-signed cert — keep as false unless you've installed the cert locally
N3URON_VERIFY_SSL=false

# How many days back to pull (default 7)
DAYS_BACK=7

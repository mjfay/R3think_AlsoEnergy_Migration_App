# N3uron REST API connection settings
# Copy this file to .env and fill in your values.

N3URON_HOST=192.168.1.100
N3URON_PORT=3443

# Auth type: "basic" (username + password) or "token" (bearer token)
N3URON_AUTH_TYPE=basic

# Used when AUTH_TYPE=basic
N3URON_USERNAME=admin
N3URON_PASSWORD=

# Used when AUTH_TYPE=token
N3URON_TOKEN=

# Set to "false" if N3uron uses a self-signed certificate (typical for on-prem installs)
N3URON_VERIFY_SSL=false
